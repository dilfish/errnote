{
  "name": "errnote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "家庭错题本：拍照/打字录入，AI 识别题目与知识点",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 \"server/test/**/*.test.ts\"",
    "seed:load": "node scripts/seed-load.ts",
    "seed:demo": "node scripts/seed-demo.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
